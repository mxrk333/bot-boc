{
  "name": "@repo/functions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outdir=dist --format=esm --external:firebase-functions --external:firebase-admin --external:@google-cloud/vertexai --external:@trpc/server --external:zod",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "@trpc/server": "^11.0.0-rc.660",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "eslint": "^8.57.0",
    "typescript": "5.5.4",
    "vitest": "^2.1.8"
  }
}
